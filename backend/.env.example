# 복사해서 .env 로 저장한다. .env 는 커밋하지 않는다.

APP_ENV=dev
ENABLE_DOCS=true
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/issues
STORAGE_DIR=storage
# 업로드 음성 최대 크기(MB)
MAX_UPLOAD_MB=25

# 자리표시 값. dev 에서는 경고만 하고, 그 외 환경에서는 서버가 시작되지 않는다.
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_ABSOLUTE_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
# 비우면 APP_ENV != dev 일 때 Secure 쿠키
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/auth

# 데모 계정 비밀번호. 코드에 넣지 않는다.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR1_PASSWORD=
SEED_OPERATOR2_PASSWORD=
SEED_OPERATOR3_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_OPERATOR1_USERNAME=operator1
SEED_OPERATOR2_USERNAME=operator2
SEED_OPERATOR3_USERNAME=operator3

# 게이트웨이 키 하나. Claude, GPT, Jev, 게이트웨이 STT 가 같이 쓴다.
# 호출 방식은 팀 확인 전까지 비워 둔다.
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
# TODO: 팀이 확인한 Claude 모델명. 임의로 확정하지 않는다.
CLAUDE_MODEL=
# TODO: 팀이 확인한 고정 버전. latest 같은 별칭을 넣지 않는다.
JEV_MODEL_VERSION=

STT_PROVIDER=mock
EXTRACTOR_PROVIDER=mock
CLASSIFIER_PROVIDER=mock

# 임시 임계값. tune 데이터로 보정 후 확정.
CLS_CONF_HIGH=0.85
CLS_CONF_LOW=0.55
STT_CONF_MIN=0.6

# 명시 목록만. * 는 허용하지 않는다.
CORS_ORIGINS=http://localhost:5173
